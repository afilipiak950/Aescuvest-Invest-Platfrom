# Database Configuration (Required)
DATABASE_URL=postgresql://username:password@host:port/database

# AI Services API Keys (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Microsoft Graph API for Email Features (Required)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id

# Email Service (Required)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Security Configuration (Required)
SESSION_SECRET=your-secure-session-secret-minimum-32-characters-long

# Application Environment (Required)
NODE_ENV=production
PORT=5000

# Optional Configuration
REPLIT_DOMAINS=your-app-domain.replit.app